{"beats": [{"id": "b1", "pause_after_ms": 300, "performance": {"expression": "deadpan", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "I'm a gnome. Four hundred years old, two foot nine, earth elemental. I guard these three lawns. Personally.", "type": "setup"}, {"id": "b2", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Paracelsus said we exist. He was right. He never mentioned the flamingos.", "type": "setup"}, {"id": "b3", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "Rule one: when a human looks at me, I freeze. Full statue. Even if I was winning the argument.", "type": "setup"}, {"id": "b4", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "Last Tuesday I froze six hours holding a rake I don't own. A dog pissed on my boot. I held the pose.", "type": "punchline"}, {"id": "b5", "pause_after_ms": 500, "performance": {"expression": "grin", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "The hat stays on. Red. Pointed. Never washed.", "type": "tag"}, {"id": "b6", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "I take bribes. Porridge. Milk. One family leaves honey. They get zero violations. The rest get citations.", "type": "setup"}, {"id": "b7", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "Violations this week: plastic flamingo, unlicensed mushroom circle, dog. Just dog. Dog knows what he did.", "type": "setup"}, {"id": "b8", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "Concrete gives me hives. This street is paved. I'm a firefighter living in a matchbox.", "type": "punchline"}, {"id": "b9", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "You want a garden that thrives? Leave milk. Say nothing. Look away.", "type": "setup"}, {"id": "b10", "pause_after_ms": 800, "performance": {"expression": "confused", "gesture": "shrug", "look": "audience"}, "speech": {"emphasis": 0.8, "pace": "normal"}, "text": "You're looking at me right now.", "type": "punchline"}, {"id": "b11", "pause_after_ms": 1200, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 1.0, "pace": "normal"}, "text": "Watch the flamingo.", "type": "closer"}], "metadata": {"beat_count": 11, "punchline_count": 3, "total_duration_ms": 61000, "word_count": 148}, "profile": {"energy": 0.75, "eye_contact": 0.5, "gesture_frequency": 0.6, "movement": 0.45, "pace": 0.95, "punchline_hold_ms": 850}, "version": "freaktown.delivery.v1", "voice": {"provider": "edge-tts", "voice_id": "en-US-AriaNeural"}}