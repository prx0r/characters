{"beats": [{"id": "b1", "pause_after_ms": 300, "performance": {"expression": "deadpan", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "I'm Rudy. Reptilian. Dulce level four. I do HVAC. Heating, ventilation, and calming down.", "type": "setup"}, {"id": "b2", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Surface sends cold air down here. Sixty-eight degrees. That's an insult with a thermostat.", "type": "setup"}, {"id": "b3", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "Ralph files complaints. I fix them. He middle-manages. I middle-fan.", "type": "setup"}, {"id": "b4", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "You think lizards love heat lamps. Try maintaining one for a whole base on a government budget.", "type": "punchline"}, {"id": "b5", "pause_after_ms": 500, "performance": {"expression": "confused", "gesture": "shrug", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "The warmth requisition is eleven pages. I fill it out basking. Still denied.", "type": "tag"}, {"id": "b6", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Deros keep rewiring my ducts for pranks. Different department. Same basement.", "type": "setup"}, {"id": "b7", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "Last week one reversed the airflow. Three generals in parkas. I got written up.", "type": "setup"}, {"id": "b8", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "My review says: adequate warmth, excessive hissing.", "type": "punchline"}, {"id": "b9", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Transfer? Denied. I'm the only tech who knows which vent screams.", "type": "setup"}, {"id": "b10", "pause_after_ms": 800, "performance": {"expression": "surprised", "gesture": "look left", "look": "audience"}, "speech": {"emphasis": 0.8, "pace": "normal"}, "text": "It screams.", "type": "punchline"}, {"id": "b11", "pause_after_ms": 1200, "performance": {"expression": "deadpan", "gesture": "lean in", "look": "audience"}, "speech": {"emphasis": 1.0, "pace": "normal"}, "text": "Stay warm. Hydrate.", "type": "closer"}], "metadata": {"beat_count": 11, "punchline_count": 3, "total_duration_ms": 61000, "word_count": 140}, "profile": {"energy": 0.6, "eye_contact": 0.6, "gesture_frequency": 0.4, "movement": 0.35, "pace": 0.9, "punchline_hold_ms": 1000}, "version": "freaktown.delivery.v1", "voice": {"provider": "edge-tts", "voice_id": "en-US-GuyNeural"}}