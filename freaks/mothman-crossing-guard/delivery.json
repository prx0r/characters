{"beats": [{"id": "b1", "pause_after_ms": 600, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "Stop. Vest means stop. I am the crossing guard. The bridge is closed. It is always closed.", "type": "setup"}, {"id": "b2", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "I'm a mothman. Seven feet. Wings. Eyes like brake lights. Whistle like a kettle.", "type": "setup"}, {"id": "b3", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "They call me a harbinger. I prefer crossing guard. Harbingers don't get dental.", "type": "setup"}, {"id": "b4", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "I kept pace with a car once. Highway speed. Driver still tells it. I was jogging.", "type": "punchline"}, {"id": "b5", "pause_after_ms": 500, "performance": {"expression": "confused", "gesture": "shrug", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "Never caught anyone. Cardio without closure. My Fitbit filed for overtime.", "type": "tag"}, {"id": "b6", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Owl-truthers hand out pamphlets at my shows. Big bird, they say. Ears differ.", "type": "setup"}, {"id": "b7", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "I eat the pamphlets. High fiber. Low accuracy.", "type": "setup"}, {"id": "b8", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "Doom never explains. That's policy. Explanations are for owls.", "type": "punchline"}, {"id": "b9", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Kids cross safe on my watch. Cars stop. Time stops. Everybody stops.", "type": "setup"}, {"id": "b10", "pause_after_ms": 800, "performance": {"expression": "surprised", "gesture": "big gesture", "look": "audience"}, "speech": {"emphasis": 0.8, "pace": "normal"}, "text": "Look left. Look right. Look up.", "type": "punchline"}, {"id": "b11", "pause_after_ms": 1200, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 1.0, "pace": "normal"}, "text": "Bridge closed. Walk.", "type": "closer"}], "metadata": {"beat_count": 11, "punchline_count": 3, "total_duration_ms": 61000, "word_count": 138}, "profile": {"energy": 0.5, "eye_contact": 1.0, "gesture_frequency": 0.25, "movement": 0.4, "pace": 0.85, "punchline_hold_ms": 1300}, "version": "freaktown.delivery.v1", "voice": {"provider": "edge-tts", "voice_id": "en-US-ChristopherNeural"}}