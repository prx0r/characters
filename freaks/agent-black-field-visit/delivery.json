ience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "Missing time? That was Tuesday. It is now never.", "type": "punchline"}, {"id": "b9", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Questions are statements here. You have no questions.", "type": "setup"}, {"id": "b10", "pause_after_ms": 800, "performance": {"expression": "surprised", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.8, "pace": "normal"}, "text": "Garden.", "type": "punchline"}, {"id": "b11", "pause_after_ms": 1200, "performance": {"expression": "deadpan", "gesture": "lean in", "look": "audience"}, "speech": {"emphasis": 1.0, "pace": "normal"}, "text": "Forget the sky. Water.", "type": "closer"}], "metadata": {"beat_count": 11, "punchline_count": 3, "total_duration_ms": 61000, "word_count": 136}, "profile": {"energy": 0.4, "eye_contact": 0.95, "gesture_frequency": 0.2, "movement": 0.25, "pace": 0.85, "punchline_hold_ms": 1300}, "version": "freaktown.delivery.v1", "voice": {"provider": "edge-tts", "voice_id": "en-US-TonyNeural"}}