deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "Don't step in the mushroom circle. That's not decor. That's my front door and you left mud on it.", "type": "punchline"}, {"id": "b9", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "Ask my name again and I'll bill you. Names are leashes. Mine is filed under no.", "type": "setup"}, {"id": "b10", "pause_after_ms": 800, "performance": {"expression": "surprised", "gesture": "look left", "look": "audience"}, "speech": {"emphasis": 0.8, "pace": "normal"}, "text": "Is that iron?", "type": "punchline"}, {"id": "b11", "pause_after_ms": 1200, "performance": {"expression": "grin", "gesture": "lean in", "look": "audience"}, "speech": {"emphasis": 1.0, "pace": "normal"}, "text": "Milk. Honey. Leave.", "type": "closer"}], "metadata": {"beat_count": 11, "punchline_count": 3, "total_duration_ms": 61000, "word_count": 147}, "profile": {"energy": 0.85, "eye_contact": 0.8, "gesture_frequency": 0.7, "movement": 0.65, "pace": 1.0, "punchline_hold_ms": 800}, "version": "freaktown.delivery.v1", "voice": {"provider": "edge-tts", "voice_id": "en-US-JennyNeural"}}