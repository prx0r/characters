{"beats": [{"id": "b1", "pause_after_ms": 300, "performance": {"expression": "deadpan", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "I'm a kappa. River imp, four hundred years old. Five feet in water, four foot two on land.", "type": "setup"}, {"id": "b2", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "I run river protection. Payment is cucumbers. Strictly cucumbers.", "type": "setup"}, {"id": "b3", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "Current ledger: forty-seven cucumbers outstanding. Dave from apartment 3B owes me nine. Nine.", "type": "setup"}, {"id": "b4", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "He offered me a pickle. A pickle is not a cucumber. That's like paying your priest in Halloween candy.", "type": "punchline"}, {"id": "b5", "pause_after_ms": 500, "performance": {"expression": "confused", "gesture": "lean in", "look": "audience"}, "speech": {"emphasis": 0.6, "pace": "normal"}, "text": "I bowed to decline. Then I bowed to apologize for bowing. Then the automatic door bowed back.", "type": "tag"}, {"id": "b6", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "This dish on my head must stay wet. If it spills, I faint. Instantly.", "type": "setup"}, {"id": "b7", "pause_after_ms": 1000, "performance": {"expression": "annoyed", "gesture": "small gesture", "look": "audience"}, "speech": {"emphasis": 0.7, "pace": "normal"}, "text": "Last week a kid with a Super Soaker took me out from twenty feet. I woke in a kiddie pool.", "type": "setup"}, {"id": "b8", "pause_after_ms": 1500, "performance": {"expression": "deadpan", "gesture": "hold still", "look": "audience"}, "speech": {"emphasis": 0.9, "pace": "normal"}, "text": "He challenged me to sumo. I accepted. Obviously. It's the law.", "type": "punchline"}, {"id": "b9", "pause_after_ms": 300, "performance": {"expression": "neutral", "gesture": "normal", "look": "audience"}, "speech": {"emphasis": 0.5, "pace": "normal"}, "text": "He weighed forty pounds. He still won. He used the oldest trick in the book.", "type": "setup"}, {"id": "b10", "pause_after_ms": 800, "performance": {"expression": "surprised", "gesture": "shrug", "look": "audience"}, "speech": {"emphasis": 0.8, "pace": "normal"}, "text": "He bowed first.", "type": "punchline"}, {"id": "b11", "pause_after_ms": 1200, "performance": {"expression": "grin", "gesture": "lean in", "look": "audience"}, "speech": {"emphasis": 1.0, "pace": "normal"}, "text": "Bow back. I dare you.", "type": "closer"}], "metadata": {"beat_count": 11, "punchline_count": 3, "total_duration_ms": 61000, "word_count": 144}, "profile": {"energy": 0.7, "eye_contact": 0.7, "gesture_frequency": 0.55, "movement": 0.5, "pace": 0.92, "punchline_hold_ms": 900}, "version": "freaktown.delivery.v1", "voice": {"provider": "edge-tts", "voice_id": "en-US-GuyNeural"}}